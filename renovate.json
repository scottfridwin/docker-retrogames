{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "prCreation": "immediate",
  "automerge": true,
  "automergeType": "pr",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images pinned in workflows with a '# renovate:' comment",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*[^:\\s]+:(?<currentValue>[^@\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflows with a '# renovate:' comment",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+:\\s*(?<currentValue>[^\\s:@]+)\\s"
      ]
    }
  ],
  "assignees": ["scottfridwin"],
  "packageRules": [
    {
      "description": "js-dos 8 is a different player/API; upgrade deliberately",
      "matchPackageNames": ["js-dos"],
      "allowedVersions": "<8"
    },
    {
      "description": "jQuery 4 drops APIs Bootstrap's jQuery integration and this app may rely on; upgrade deliberately",
      "matchPackageNames": ["jquery"],
      "allowedVersions": "<4"
    },
    {
      "description": "Node in the workflow and Dockerfile moves together",
      "groupName": "Node",
      "matchPackageNames": ["node"]
    }
  ]
}
